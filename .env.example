# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection URL (Optional - Falls back to local/memory mode)
MONGODB_URI=mongodb://127.0.0.1:27017/goti_jibon

# Gmail OTP Authenticator Configuration
# Step 1: Visit https://myaccount.google.com/security and enable 2-Step Verification
# Step 2: Visit https://myaccount.google.com/apppasswords to create an App Password
# Step 3: Enter your Gmail & 16-character App Password below:
GMAIL_USER=gotiejibon@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password_here
